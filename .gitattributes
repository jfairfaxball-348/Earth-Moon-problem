* text=auto eol=lf
*.gz -text
# Preserve checker progress output, including its carriage returns/padding.
validation/S004/**/*.log -whitespace
# S005 log hashes refer to observed bytes, including native Windows CRLF.
validation/S005/**/*.log -text -whitespace
# S006 retains the exact observed native checker/supervisor log bytes.
validation/S006/**/*.log -text -whitespace
# S007 retains actual native/supervisor/model log bytes.
validation/S007/**/*.log -text -whitespace
# S008 preserves the observed native checker and supervisor bytes.
validation/S008/**/*.log -text -whitespace
# S009 evidence hashes include exact observed logs and launch snapshots.
validation/S009/** -text -whitespace
# S010 preserves native logs and exact immutable source/launch snapshots.
validation/S010/** -text -whitespace
# S025 certificate hashes refer to the exact edge-file bytes as written.
validation/S025/certs/*.edges -text -whitespace
# Preserve the original source bytes named by the S025 manifest (including CRLF).
tools/s025_check.py -text -whitespace
tools/s025_indep_anneal.py -text -whitespace
tools/s025_minor_cegar.py -text -whitespace
